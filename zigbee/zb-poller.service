# Служба опроса счётчика Saiman через Zigbee-мост.
# Замените пользователя и пути на свои: User=, WorkingDirectory=, ExecStart=.
[Unit]
Description=ZigBee Saiman meter poller -> MQTT OpenEgiz (lower_lab:zigbee-meter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/zigbee
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/pi/zigbee/venv/bin/python -u zb_poller.py --port auto --interval 30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
